ENV=production

JWT_SECRET=

# --- LLM providers (at least one required) ---
# Gateway (app/services/llm/) tries these in LLM_PROVIDER_PRIORITY order,
# falling back automatically if one fails. Only set the ones you have keys for.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER_PRIORITY=gemini,openai,groq

# --- Real flight data (three-tier fallback) ---
# Duffel — real bookable offers with real prices. Best option, self-serve.
# Amadeus's self-service portal was decommissioned July 17, 2026; Duffel is
# the self-serve replacement. Free test key in ~1 minute:
# https://app.duffel.com/join -> Developers -> Access tokens (developer test mode)
DUFFEL_API_KEY=
DUFFEL_VERSION=v2

# AviationStack — real airlines/flight numbers/schedules, but NO real
# pricing (it's a flight-tracking API, not a fares API); prices are a
# synthetic-but-consistent estimate. Used only if Duffel isn't configured
# or fails. Note: the Future Flight Schedules endpoint this needs is a
# paid-tier feature on AviationStack — the free plan won't unlock it.
# https://aviationstack.com
AVIATIONSTACK_API_KEY=

# If neither of the above is configured, search_agent.py falls back to
# fully LLM-generated (synthetic schedule AND price) flight data.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Standard SMTP configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_TLS=true
EMAIL_FROM=bookings@example.com
